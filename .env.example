# Copie para .env e preencha localmente. Nunca commite o .env.
# Sem valores aqui. Gere segredos novos para cada ambiente.

# Evolution API (instalação local, somente 127.0.0.1)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Banco local da Evolution API (PostgreSQL)
DATABASE_CONNECTION_URI=

# Aplicação
TIMEZONE=America/Fortaleza
